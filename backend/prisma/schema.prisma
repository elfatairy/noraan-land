generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Course {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(255)
  privatePrice    Float
  groupPrice      Float
  description     String?         @db.VarChar(1024)
  zoomLink        String          @db.VarChar(255)
  paypalProductId String?         @db.VarChar(255)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        Session[]
  studentCourses  StudentCourse[]
  quizes          Quiz[]
}

model Session {
  id             Int           @id @default(autoincrement())
  courseId       Int
  status         SessionStatus @default(UPCOMING)
  title          String        @db.VarChar(255)
  description    String?       @db.VarChar(1024)
  isFree         Boolean       @default(false)
  calendarDateId Int           @unique

  sessionType      SessionType
  groupId          Int?
  privateStudentId Int?

  startedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course       Course       @relation(fields: [courseId], references: [id])
  calendarDate CalendarDate @relation(fields: [calendarDateId], references: [id])
  Recording    Recording[]

  StudentSession StudentSession[]
}

model Recording {
  id        Int      @id @default(autoincrement())
  bunnyGuid String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Session   Session  @relation(fields: [sessionId], references: [id])
  sessionId Int
}

model Student {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(255)
  phone           String?          @db.VarChar(255)
  email           String           @unique @db.VarChar(255)
  password        String?
  age             Int?
  location        String?
  gender          Gender?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  studentCourses  StudentCourse[]
  studentSessions StudentSession[]
}

model Group {
  id        Int      @id @default(autoincrement())
  courseId  Int
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentCourses StudentCourse[]
}

model StudentCourse {
  id        Int  @id @default(autoincrement())
  studentId Int
  courseId  Int
  groupId   Int?

  preferredSessionType SessionType
  availableTime        String      @db.VarChar(255)
  studentNotes         String?     @db.VarChar(255)

  hours Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group                     Group?                     @relation(fields: [groupId], references: [id])
  student                   Student                    @relation(fields: [studentId], references: [id])
  course                    Course                     @relation(fields: [courseId], references: [id])
  StudentCourseSubscription StudentCourseSubscription?
}

model StudentCourseSubscription {
  id                   Int                 @id @default(autoincrement())
  studentCourseId      Int                 @unique
  studentCourse        StudentCourse?      @relation(fields: [studentCourseId], references: [id])
  subscriptionStatus   SubscriptionStatus  @default(UNSUBSCRIBED)
  subscriptionMethod   SubscriptionMethod?
  paypalSubscriptionId String?
  paymobIntentionId    String?
  paymobTransactionId  Int?
  paymobSubscriptionId Int?
  paypalPlanId         String?
  paymobPlanId         Int?
}

model StudentSession {
  id        Int @id @default(autoincrement())
  studentId Int
  sessionId Int

  notes      String?    @db.VarChar(255)
  homeWork   String?    @db.VarChar(255)
  tardy      Int?
  attendence Attendence @default(ABSENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id])
}

model CalendarDate {
  id             Int                        @id @default(autoincrement())
  startDate      DateTime
  endDate        DateTime
  duration       Int                        @default(60)
  status         CalendarDateStatus         @default(AVAILABLE)
  changingStatus CalendarDateChangingStatus @default(UNCHANGED)
  session        Session?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model Quiz {
  id        Int      @id @default(autoincrement())
  courseId  Int
  link      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

enum CalendarDateStatus {
  AVAILABLE
  DONE
}

enum SessionStatus {
  UPCOMING
  RUNNING
  ENDED
}

enum CalendarDateChangingStatus {
  UNCHANGED
  CHANGED
  CANCELED
}

enum SubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum SessionType {
  PRIVATE
  GROUP
}

enum Gender {
  MALE
  FEMALE
}

enum SubscriptionMethod {
  PAYPAL
  PAYMOB
  FREE
}

enum Attendence {
  ABSENT
  PRESENT
}
