generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Prisma schema

model Course {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(255)
  groupPrice         Float?
  individualPrice    Float?
  description        String?             @db.VarChar(1024)
  createdAt          DateTime            @default(now()) @db.Timestamp
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamp
  groupSessions      GroupSession[]
  individualSessions IndividualSession[]
  userCourses        UserCourse[]

  subscribtionHistory subscribtionHistory[]
}

model GroupSession {
  id          Int           @id @default(autoincrement())
  courseId    Int
  status      SessionStatus @default(UPCOMING)
  title       String        @db.VarChar(255)
  description String?       @db.VarChar(1024)
  isFree      Boolean       @default(false)

  meetingId BigInt?

  startedAt DateTime? @db.Timestamp
  createdAt DateTime  @default(now()) @db.Timestamp
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp

  course         Course        @relation(fields: [courseId], references: [id])
  userSessions   UserSession[]
  calendarDateId Int           @unique
  calendarDate   CalendarDate  @relation(fields: [calendarDateId], references: [id])
  Recording      Recording[]
}

model IndividualSession {
  id          Int           @id @default(autoincrement())
  courseId    Int
  userId      Int
  status      SessionStatus @default(UPCOMING)
  title       String        @db.VarChar(255)
  description String?       @db.VarChar(1024)
  isFree      Boolean       @default(false)

  notes String? @db.VarChar(255)

  meetingId BigInt?

  startedAt DateTime? @db.Timestamp
  createdAt DateTime  @default(now()) @db.Timestamp
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  calendarDateId Int          @unique
  calendarDate   CalendarDate @relation(fields: [calendarDateId], references: [id])
  Recordings     Recording[]
}

model Recording {
  id          Int         @id @default(autoincrement())
  sessionType SessionType
  bunnyGuid   String

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp

  IndividualSession   IndividualSession? @relation(fields: [IndividualSessionid], references: [id])
  IndividualSessionid Int?
  GroupSession        GroupSession?      @relation(fields: [groupSessionId], references: [id])
  groupSessionId      Int?
}

model User {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  email    String  @unique @db.VarChar(255)
  password String?

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp

  userCourses            UserCourse[]
  userSessions           UserSession[]
  userIndividualSessions IndividualSession[]
  subscribtionHistory    subscribtionHistory[]
}

model UserCourse {
  id            Int     @id @default(autoincrement())
  userId        Int
  courseId      Int
  availableTime String  @db.VarChar(255)
  userNotes     String? @db.VarChar(255)
  viewedByAdmin Boolean @default(false)

  subscribtionStatus SubscribtionStatus @default(UNSUBSCRIBED)
  sessionType        SessionType

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model UserSession {
  id        Int     @id @default(autoincrement())
  userId    Int
  sessionId Int
  notes     String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp

  user    User         @relation(fields: [userId], references: [id])
  session GroupSession @relation(fields: [sessionId], references: [id])
}

model subscribtionHistory {
  id Int @id @default(autoincrement())

  amountPaid Float

  createdAt DateTime @default(now()) @db.Timestamp

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model CalendarDate {
  id                Int                @id @default(autoincrement())
  startDate         DateTime
  endDate           DateTime
  duration          Int                @default(60)
  type              CalendarDateType
  status            CalendarDateStatus @default(AVAILABLE)
  groupSession      GroupSession?
  individualSession IndividualSession?
  createdAt         DateTime           @default(now()) @db.Timestamp
  updatedAt         DateTime           @default(now()) @updatedAt @db.Timestamp
}

enum CalendarDateType {
  GROUP_SESSION
  INDIVIDUAL_SESSION
}

enum CalendarDateStatus {
  AVAILABLE
  PASSED
}

enum SessionStatus {
  UPCOMING
  RUNNING
  ENDED
}

enum SessionType {
  INDIVIDUAL
  GROUP
}

enum SubscribtionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}
